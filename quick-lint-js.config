{
    "_comment": [
        "Obsidian injects these as globals and declares them in node_modules/obsidian/obsidian.d.ts.",
        "quick-lint-js does not read .d.ts files, so without this list it reports E0057",
        "'use of undeclared variable' for every one of them. TypeScript itself is clean:",
        "verify with 'npm run build' (tsc -noEmit -skipLibCheck)."
    ],
    "globals": {
        "app": true,
        "activeDocument": true,
        "activeWindow": true,
        "ajax": true,
        "ajaxPromise": true,
        "createDiv": true,
        "createEl": true,
        "createFragment": true,
        "createSpan": true,
        "createSvg": true,
        "fish": true,
        "fishAll": true,
        "ready": true,
        "sleep": true
    }
}
