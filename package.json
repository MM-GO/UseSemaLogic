{
	"name": "UseSemaLogic",
	"version": "2.4.0",
	"description": "Real-time use of the SemaLogic formal languages",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"release": "node scripts/publish.mjs",
		"test": "jest",
		"test:obsidian:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-obsidian-preflight.ps1",
		"test:obsidian:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-obsidian.ps1 -Mode smoke",
		"test:obsidian:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-obsidian.ps1 -Mode integration -ServerCleanup process",
		"test:obsidian:integration:keep-server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-obsidian.ps1 -Mode integration -ServerCleanup keep",
		"test:obsidian:integration:stop-server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-obsidian.ps1 -Mode integration -ServerCleanup process"
	},
	"keywords": [],
	"author": "SemaLogic UG",
	"license": "Plugin under GnuGPLv3 (SemaLogic-service currently free use of a commercial license for testing)",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.1",
		"jest": "^29.6.2",
		"jest-environment-jsdom": "^30.4.1",
		"obsidian": "latest",
		"ts-jest": "^29.1.1",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
